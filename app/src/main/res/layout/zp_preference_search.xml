<?xml version="1.0" encoding="utf-8"?>
<!-- Keep zp_row_container inside the item root. AndroidX replaces the item background. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="afterDescendants"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/zp_row_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/zp_search_background"
        android:duplicateParentState="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/zp_row_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/zp_row_padding_horizontal"
        android:paddingTop="@dimen/zp_row_padding_vertical"
        android:paddingEnd="@dimen/zp_row_padding_horizontal"
        android:paddingBottom="@dimen/zp_row_padding_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_zp_search" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/zp_search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/zp_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/zp_on_surface"
            android:textColorHint="@color/zp_text_secondary" />
    </LinearLayout>

    <View
        android:id="@+id/zp_row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/zp_row_padding_horizontal"
        android:layout_marginEnd="@dimen/zp_row_padding_horizontal"
        android:background="@color/zp_row_divider"
        android:visibility="gone" />
</LinearLayout>
