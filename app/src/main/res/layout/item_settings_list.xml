<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/zp_row_surface"
    app:cardCornerRadius="@dimen/zp_group_radius"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/zp_row_padding_horizontal"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/zp_row_padding_horizontal"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/zp_list_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/zp_on_surface" />

        <TextView
            android:id="@+id/zp_list_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="3"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/zp_text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
