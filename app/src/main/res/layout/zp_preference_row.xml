<?xml version="1.0" encoding="utf-8"?>
<!-- Connected group row. Shape, divider, chevron, dot, value, and chips are bound in code. -->
<!-- The outer view is the RecyclerView item view. AndroidX Preference.onBindViewHolder
     manages that view's background itself, so the group shape must be carried by an inner
     container it does not touch. Flattening these two into one view silently loses the
     group corners and every row renders as its own rounded pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/zp_row_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/zp_row_single"
        android:duplicateParentState="true"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/zp_row_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/zp_row_padding_horizontal"
        android:paddingTop="@dimen/zp_row_padding_vertical"
        android:paddingEnd="@dimen/zp_row_padding_horizontal"
        android:paddingBottom="@dimen/zp_row_padding_vertical">

        <View
            android:id="@+id/zp_row_dot"
            android:layout_width="@dimen/zp_status_dot_size"
            android:layout_height="@dimen/zp_status_dot_size"
            android:layout_marginEnd="@dimen/zp_row_padding_vertical"
            android:background="@drawable/zp_status_dot"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@android:id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/zp_row_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/zp_row_padding_vertical"
                    android:ellipsize="end"
                    android:maxWidth="190dp"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/zp_text_secondary"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@android:id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/zp_text_secondary" />

            <com.ez.zalopatch.ZpFlowLayout
                android:id="@+id/zp_row_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@android:id/widget_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/zp_row_padding_vertical"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/zp_row_chevron"
            android:layout_width="@dimen/zp_row_chevron_size"
            android:layout_height="@dimen/zp_row_chevron_size"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_zp_chevron"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/zp_row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/zp_row_padding_horizontal"
        android:layout_marginEnd="@dimen/zp_row_padding_horizontal"
        android:background="@color/zp_row_divider"
        android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
