<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/zp_search_background"
        android:duplicateParentState="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/zp_row_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/zp_row_padding_horizontal"
        android:paddingTop="@dimen/zp_row_padding_vertical"
        android:paddingEnd="@dimen/zp_row_padding_horizontal"
        android:paddingBottom="@dimen/zp_row_padding_vertical">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@android:id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/zp_text_secondary" />
    </LinearLayout>
</FrameLayout>
