    <string name="zp_tweak_block_seen_status_summary">Chặn gửi xác nhận đã xem nhưng vẫn gửi xác nhận đã nhận. Việc hiển thị xác nhận đã xem từ người khác vẫn phụ thuộc vào cài đặt của Zalo.</string>
    <string name="zp_tweak_block_typing_status">Chặn trạng thái Đang nhập</string>
    <string name="zp_tweak_block_typing_status_summary">Chặn gửi chỉ báo đang nhập trong cuộc trò chuyện cá nhân hoặc nhóm. Chỉ báo đang nhập từ người khác không thay đổi.</string>
